# Local .terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.backup

# Crash logs
crash.log

# Plan files
*.tfplan

# Override files (local only, not checked in)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files with secrets
terraform.tfvars
terraform.tfvars.json

# Sensitive .auto.tfvars files
*.auto.tfvars
*.auto.tfvars.json

# Binary outputs
*.zip
*.tar.gz
*.bin

# IDE specific files (optional but recommended)
.vscode/
.idea/
.DS_Store